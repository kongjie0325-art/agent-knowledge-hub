  "hermes_api": {
    "description": "Hermes Agent 调用此知识库的 API 接口说明",
    "endpoints": {
      "list_industries": "GET /api/v1/industries - 列出所有行业分类",
      "get_industry": "GET /api/v1/industry/{industry_id} - 获取指定行业的仓库列表",
      "search": "GET /api/v1/search?q={query}&industry={industry}&capability={capability} - 搜索仓库",
      "get_repo": "GET /api/v1/repo/{owner}/{name} - 获取指定仓库详情",
      "list_capabilities": "GET /api/v1/capabilities - 列出所有能力分类",
      "stats": "GET /api/v1/stats - 获取统计信息"
    },
    "local_access": {
      "description": "本地文件访问方式（Hermes 直接读取）",
      "index_file": "api/index.json",
      "industry_files": "kb/industry/{industry_id}.md",
      "capability_files": "kb/capability/{capability_id}.md",
      "data_files": "data/repos_latest.json"
    },
